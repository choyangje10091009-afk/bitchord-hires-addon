
{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.js?__route=manifest"
    },
    {
      "source": "/manifest.json",
      "destination": "/api/index.js?__route=manifest"
    },
    {
      "source": "/health",
      "destination": "/api/index.js?__route=health"
    },
    {
      "source": "/search",
      "destination": "/api/index.js?__route=search"
    },
    {
      "source": "/stream/:id",
      "destination": "/api/index.js?__route=stream&id=:id"
    }
  ]
}
